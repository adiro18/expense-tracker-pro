# Copy to .env for local development (never commit .env)
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
# Leave DB_HOST empty to use local SQLite (instance/spendwise.db)
DB_HOST=
DB_PORT=3306
DB_NAME=spendwise
DB_USER=spendwise_admin
DB_PASSWORD=change-me
DEFAULT_CURRENCY=INR
# Optional: shared rate-limit storage, e.g. redis://redis:6379/0
RATELIMIT_STORAGE_URI=memory://
